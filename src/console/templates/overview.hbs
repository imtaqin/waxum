<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/" aria-label="Waxum home">
      <img src="/assets/logo.png" alt="" class="brand-mark" width="32" height="32">
      <span>Waxum</span>
      <span class="brand-chip">Console</span>
    </a>
    <span class="spacer"></span>
    <span class="version">v{{version}}</span>
    <a class="topbar-link" href="/swagger-ui" target="_blank" rel="noopener">
      <svg class="icon sm"><use href="#i-book"/></svg>
      API docs
    </a>
    <form method="post" action="/logout" style="margin:0">
      <button type="submit" class="btn sm ghost">
        <svg class="icon sm"><use href="#i-power"/></svg>
        Sign out
      </button>
    </form>
  </div>
</header>

<main class="page" id="page-root">
  {{> overview_body}}
</main>

<div id="drawer-scrim" class="drawer-scrim" onclick="closeDrawer()"></div>
<aside id="drawer" class="drawer" aria-hidden="true"></aside>

<script>
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function showDrawer(html) {
    const d = document.getElementById('drawer');
    d.innerHTML = html;
    d.classList.add('open');
    d.setAttribute('aria-hidden', 'false');
    document.getElementById('drawer-scrim').classList.add('open');
  }
  function closeDrawer() {
    const d = document.getElementById('drawer');
    d.classList.remove('open');
    d.setAttribute('aria-hidden', 'true');
    document.getElementById('drawer-scrim').classList.remove('open');
  }
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  async function refreshOverview() {
    try {
      const res = await fetch('/data', { credentials: 'same-origin' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) return;
      document.getElementById('page-root').innerHTML = await res.text();
    } catch (e) { /* network blip: try again on the next tick */ }
  }
  setInterval(refreshOverview, 3000);

  async function sessionAction(sid, action) {
    const res = await fetch('/sessions/' + encodeURIComponent(sid) + '/' + action, {
      method: 'POST',
      credentials: 'same-origin',
    });
    if (res.ok) refreshOverview();
  }

  const CLOUD_FIELDS = [
    { name: 'waba_id', label: 'WhatsApp Business Account ID', required: true, placeholder: '102290129340398' },
    { name: 'phone_number_id', label: 'Phone number ID', required: true, placeholder: '106540352242922' },
    { name: 'access_token', label: 'Access token (system user)', required: true, secret: true, placeholder: 'EAAG…' },
    { name: 'app_secret', label: 'App secret', required: true, secret: true, hint: 'Verifies the signature on webhooks Meta sends.' },
    { name: 'webhook_verify_token', label: 'Webhook verify token', required: true, hint: 'Any string you choose; paste the same value into Meta.' },
    { name: 'business_id', label: 'Business ID (optional)', placeholder: '102290129340399', hint: 'Needed for owned/client WABAs, credit lines, system users.' },
    { name: 'app_id', label: 'App ID (optional)', hint: 'Needed for the business profile photo upload.' },
  ];

  let newSessionChannel = 'web';

  function openNewSession() {
    newSessionChannel = 'web';
    showDrawer(`
      <header class="drawer-head">
        <div class="drawer-title">New session</div>
        <button class="btn ghost sm" onclick="closeDrawer()" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button>
      </header>
      <form class="drawer-body" id="new-session-form" onsubmit="submitNewSession(event)">
        <div class="field">
          <span class="label">Channel</span>
          <div class="choice-grid">
            <button type="button" class="choice web selected" id="choice-web" onclick="pickChannel('web')">
              <span class="channel web"><svg class="icon sm"><use href="#i-link"/></svg>WhatsApp Web</span>
              <span class="choice-title">Link a phone</span>
              <span class="hint">Scan a QR with the WhatsApp app. Works with any number, including groups, calls and contacts.</span>
            </button>
            <button type="button" class="choice cloud" id="choice-cloud" onclick="pickChannel('cloud')">
              <span class="channel cloud"><svg class="icon sm"><use href="#i-cloud"/></svg>Cloud API</span>
              <span class="choice-title">Meta's official API</span>
              <span class="hint">A number registered in a Meta app. Templates, Flows and catalogs; no groups or calls.</span>
            </button>
          </div>
        </div>
        <div class="field">
          <label for="ns-id">Session ID</label>
          <input id="ns-id" name="id" type="text" autocomplete="off" required pattern="[A-Za-z0-9_-]+" placeholder="marketing-jakarta">
          <div class="hint">Letters, digits, dashes and underscores. This is the id in every API path.</div>
        </div>
        <div id="ns-cloud-fields" hidden>${CLOUD_FIELDS.map(f => `
          <div class="field" style="margin-bottom:12px">
            <label for="cf-${f.name}">${esc(f.label)}</label>
            <input id="cf-${f.name}" name="${f.name}" type="${f.secret ? 'password' : 'text'}" autocomplete="off" placeholder="${esc(f.placeholder)}">
            ${f.hint ? `<div class="hint">${esc(f.hint)}</div>` : ''}
          </div>`).join('')}
          <div class="hint">The access token and app secret are stored on the server and never shown again.</div>
        </div>
        <div id="ns-error" class="err" hidden></div>
        <div class="btn-row">
          <button type="submit" class="btn primary" id="ns-submit">Create session</button>
          <button type="button" class="btn" onclick="closeDrawer()">Cancel</button>
        </div>
      </form>`);
    document.getElementById('ns-id').focus();
  }

  function pickChannel(channel) {
    newSessionChannel = channel;
    document.getElementById('choice-web').classList.toggle('selected', channel === 'web');
    document.getElementById('choice-cloud').classList.toggle('selected', channel === 'cloud');
    document.getElementById('ns-cloud-fields').hidden = channel !== 'cloud';
    CLOUD_FIELDS.forEach(f => {
      document.getElementById('cf-' + f.name).required = channel === 'cloud' && !!f.required;
    });
  }

  async function submitNewSession(ev) {
    ev.preventDefault();
    const form = ev.target;
    const errEl = document.getElementById('ns-error');
    const btn = document.getElementById('ns-submit');
    errEl.hidden = true;
    const id = form.elements.id.value.trim();
    const body = { id };
    let url = '/sessions';
    if (newSessionChannel === 'cloud') {
      url = '/sessions/cloud';
      CLOUD_FIELDS.forEach(f => {
        const v = form.elements[f.name].value.trim();
        if (v) body[f.name] = v;
      });
    } else {
      body.name = id;
    }
    btn.disabled = true;
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });
      if (res.ok) { location.href = '/s/' + encodeURIComponent(id); return; }
      let msg = 'Could not create the session (' + res.status + ')';
      try { const j = await res.json(); msg = (j.error && j.error.message) || j.message || msg; } catch (_) {}
      errEl.textContent = msg;
      errEl.hidden = false;
    } catch (e) {
      errEl.textContent = String(e);
      errEl.hidden = false;
    } finally {
      btn.disabled = false;
    }
  }
</script>
