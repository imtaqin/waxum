<div class="login-wrap">
  <form class="login-card" method="post" action="/login" autocomplete="off">
    <div class="login-brand">
      <img src="/assets/logo.png" alt="" width="48" height="48" class="brand-mark">
      <div>
        <div class="login-title">Waxum Console</div>
        <div class="hint">Sign in to manage sessions</div>
      </div>
    </div>
    <div class="field">
      <label for="token">Superadmin token</label>
      <input type="password" id="token" name="token" placeholder="paste SUPERADMIN_TOKEN" autofocus required>
    </div>
    <button class="btn primary" type="submit">Sign in</button>
    {{#if error}}<div class="err">{{error}}</div>{{/if}}
    <div class="hint">
      The token you set in <code>SUPERADMIN_TOKEN</code>. If you did not set
      one, waxum printed a generated one in its log on first start.
    </div>
  </form>
</div>
